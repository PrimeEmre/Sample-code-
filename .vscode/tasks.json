{
    "tasks": [
        {
            "type": "shell",
            "label": "Close old run of the program",
            "command": "cmd",
            "args": [
                "/c",
                "taskkill /F /IM ${fileBasenameNoExtension}.exe >nul 2>&1 & exit 0"
            ],
            "presentation": {
                "reveal": "never"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build folder",
            "command": "gcc",
            "args": [
                "-g",
                "${fileDirname}\\*.c",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Close old run of the program",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
